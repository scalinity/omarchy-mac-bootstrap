#!/usr/bin/env bash
# omarchy-bootstrap — guided dual-boot setup for Apple Silicon Macs:
# macOS → storage plan → Asahi Alarm → reboot → Omarchy Mac → developer setup.
#
# One entrypoint for both operating systems. It plans, explains, downloads with
# provenance, launches the official installers in the foreground, and records
# non-secret progress. The one partition it creates itself is the planned
# Shared partition, after checking the whole disk and a typed confirmation.

# Started with sh? Start again under bash, in bash's own mode, as the #! line
# does (stock macOS has /bin/bash 3.2). macOS's sh is bash in POSIX mode: it
# sets BASH_VERSION but rejects the bash syntax in lib/, and so does bash with
# POSIXLY_CORRECT set, so POSIX mode is restarted too. Written in plain sh,
# because this is the part a non-bash shell reads.
_omb_mode=bash
[ -n "${BASH_VERSION:-}" ] || _omb_mode="sh"
case ":${SHELLOPTS:-}:" in *:posix:*) _omb_mode=posix ;; esac
if [ "$_omb_mode" != bash ]; then
  # Started again and still not in bash's own mode: stop rather than loop.
  if [ -n "${OMB_RESTARTED:-}" ]; then
    printf 'omarchy-bootstrap: bash is still in POSIX mode; run it as: bash %s\n' "$0" >&2
    exit 1
  fi
  OMB_RESTARTED=1
  export OMB_RESTARTED
  unset POSIXLY_CORRECT
  exec bash "$0" "$@"
fi
unset _omb_mode OMB_RESTARTED

set -u
# No pipefail: probes are written as `producer | grep -q`, and grep -q exits on
# its first match, which can SIGPIPE the producer and turn a match into a failure.

# The core's protocol entry (docs/PROTOCOL.md → §3): the request on fd 3 is
# copied, bounded, and fd 3 closed before any library loads, so no process
# the core starts can hold it. The session values the core checks are taken
# before the libraries set defaults of their own.
if [ "${1:-}" = core ]; then
  OMB_CORE_ENV_HOME=${OMB_HOME:-} OMB_CORE_ENV_DRY=${OMB_DRY_RUN-} OMB_CORE_COPY="" OMB_CORE_HEAD=1
  if OMB_TMP=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-bootstrap.XXXXXX" 3<&-); then
    OMB_CORE_COPY=$OMB_TMP/request
    head -c 65537 2>/dev/null <&3 >"$OMB_CORE_COPY" 3<&-
    OMB_CORE_HEAD=$?
  fi
  exec 3<&-
fi

_self=${BASH_SOURCE[0]}
while [ -L "$_self" ]; do
  _link=$(readlink "$_self")
  case "$_link" in /*) _self=$_link ;; *) _self="$(dirname "$_self")/$_link" ;; esac
done
OMB_HOME=$(cd "$(dirname "$_self")" && pwd -P)
unset _self _link

# A library that does not load leaves part of the program undefined: stop
# before any command runs, --version and --help included.
_omb_unloaded() {
  printf 'omarchy-bootstrap: lib/%s.sh could not be loaded; nothing was run.\n' "$1" >&2
  exit 1
}
# shellcheck source=lib/common.sh
. "$OMB_HOME/lib/common.sh" || _omb_unloaded common
# shellcheck source=lib/ui.sh
. "$OMB_HOME/lib/ui.sh" || _omb_unloaded ui
# shellcheck source=lib/state.sh
. "$OMB_HOME/lib/state.sh" || _omb_unloaded state
# shellcheck source=lib/sources.sh
. "$OMB_HOME/lib/sources.sh" || _omb_unloaded sources
# shellcheck source=lib/storage.sh
. "$OMB_HOME/lib/storage.sh" || _omb_unloaded storage
# shellcheck source=lib/macos.sh
. "$OMB_HOME/lib/macos.sh" || _omb_unloaded macos
# shellcheck source=lib/asahi.sh
. "$OMB_HOME/lib/asahi.sh" || _omb_unloaded asahi
# shellcheck source=lib/shared.sh
. "$OMB_HOME/lib/shared.sh" || _omb_unloaded shared
# shellcheck source=lib/linux.sh
. "$OMB_HOME/lib/linux.sh" || _omb_unloaded linux
# shellcheck source=lib/doctor.sh
. "$OMB_HOME/lib/doctor.sh" || _omb_unloaded doctor
# shellcheck source=lib/dev.sh
. "$OMB_HOME/lib/dev.sh" || _omb_unloaded dev

usage() {
  ui_header "v$OMB_VERSION"
  printf '\n   %sGuided dual boot: macOS + Omarchy on Apple Silicon.%s\n' "$C_BOLD" "$C_RESET"
  ui_note "Run it on macOS to plan storage and launch the Asahi Alarm installer. Run it again on the new Arch system to continue into Omarchy. It detects which side it is on."
  ui_section "Usage"
  printf '     %somarchy-bootstrap%s %s[command] [flags]%s\n' "$C_ACCENT" "$C_RESET" "$C_DIM" "$C_RESET"
  ui_section "Commands"
  _help_row "(no command)" "guided flow: continues from wherever this machine is"
  _help_row "plan" "survey + storage plan + choices; saves them, runs nothing"
  _help_row "install" "run the current phase end to end"
  _help_row "resume [token]" "continue after a reboot (Linux: paste the Phase 1 token)"
  _help_row "status" "where this machine is, and what comes next (read-only)"
  _help_row "doctor" "read-only health checks"
  _help_row "dev" "optional developer setup (Linux, after Omarchy)"
  _help_row "shared [status]" "Shared macOS/Linux storage: where it stands (read-only)"
  _help_row "shared create" "macOS: create the planned Shared partition"
  _help_row "shared activate" "Linux: mount Shared at /mnt/shared on every boot"
  _help_row "shared test" "write, read back and remove one test file"
  _help_row "sources [--check]" "upstream URLs and versions; --check compares live (read-only)"
  _help_row "logs" "log location and recent entries (read-only)"
  ui_section "Flags"
  _help_row "--dry-run" "show every step; change nothing, keep nothing"
  _help_row "--no-color" "plain output (also: NO_COLOR=1)"
  _help_row "--ascii" "ASCII glyphs only"
  _help_row "-h, --help" "this help"
  _help_row "--version" "print the version"
  ui_section "Boundaries"
  ui_note "The Asahi installer resizes macOS and creates the Linux partitions; omarchy-mac-setup owns the boot move and encryption. This tool creates one partition itself, the planned Shared partition, only after checking the whole disk and a typed confirmation, and never resizes, erases, deletes or formats a partition. It never stores a password, and never launches an installer without a typed confirmation."
  printf '\n'
}

# Before ui_init there is no palette, so usage errors are plain text.
_usage_error() { printf 'omarchy-bootstrap: %s (see --help)\n' "$1" >&2; }

_help_row() { printf '     %s%-20s%s %s%s%s\n' "$C_BOLD" "$1" "$C_RESET" "$C_DIM" "$2" "$C_RESET"; }

on_interrupt() {
  ui_cursor_restore
  # bash runs this trap after the foreground command exits, so a command that
  # was executing when Ctrl-C arrived may already have changed the machine.
  if [ -n "${OMB_RUNNING:-}" ]; then
    printf '\n\n   %sStopped while running:%s %s\n   It may have made changes. ./omarchy-bootstrap status shows where things are.\n\n' "$C_BOLD" "$C_RESET" "$OMB_RUNNING"
    log_event stop "interrupted by user while running: $OMB_RUNNING"
  else
    printf '\n\n   %sStopped.%s Nothing destructive ran.\n\n' "$C_BOLD" "$C_RESET"
    log_event stop "interrupted by user"
  fi
  exit 130
}

main() {
  local cmd="" arg
  local -a rest=()
  for arg in "$@"; do
    case "$arg" in
      --dry-run) OMB_DRY_RUN=1 ;;
      --no-color) OMB_COLOR=never ;;
      --ascii) OMB_ASCII=1 ;;
      --no-tui) OMB_NO_TUI=1 ;;
      -h | --help) cmd=help ;;
      --version) cmd=version ;;
      --check) rest+=("$arg") ;;
      # A mistyped --dry-run must stop, not silently become a real run.
      -*) _usage_error "unknown flag: $arg" ; return 2 ;;
      *)
        if [ -z "$cmd" ]; then
          cmd=$arg
        else
          rest+=("$arg")
        fi
        ;;
    esac
  done
  # Test seams stay out of root runs: a fixture or recorder carried through
  # `sudo -E` or `su` must not steer anything done with root's authority.
  if [ "$(id -u)" = 0 ] && [ -n "${OMB_FIXTURE:-}${OMB_TEST_RECORD:-}${OMB_TEST_AFTER:-}${OMB_TEST_RC:-}" ]; then
    _usage_error "OMB_FIXTURE, OMB_TEST_RECORD, OMB_TEST_AFTER and OMB_TEST_RC are for tests and are refused as root"
    return 2
  fi
  # The frontend's seams work only against fixtures, never as root: an
  # unreleased frontend or a test child never drives a real machine.
  if [ -n "${OMB_TEST_HANDOFF_CHILD:-}${OMB_FRONTEND_DEV:-}" ]; then
    if [ "$(id -u)" = 0 ] || [ -z "${OMB_FIXTURE:-}" ]; then
      _usage_error "OMB_TEST_HANDOFF_CHILD and OMB_FRONTEND_DEV work only in fixture mode (OMB_FIXTURE), never as root"
      return 2
    fi
  fi
  # The core answers on its event spool, never on the terminal.
  if [ "$cmd" = core ]; then
    [ "$#" = 2 ] || { _usage_error "core takes exactly one operation" ; return 2; }
    case "${rest[0]}" in hello | snapshot | detail | validate | execute) ;; *) _usage_error "unknown core operation" ; return 2 ;; esac
    ui_init
    # shellcheck source=lib/records.sh
    . "$OMB_HOME/lib/records.sh" || _omb_unloaded records
    # shellcheck source=lib/core.sh
    . "$OMB_HOME/lib/core.sh" || _omb_unloaded core
    core_main "${rest[0]}" "${OMB_CORE_COPY:-}" "${OMB_CORE_HEAD:-1}"
    return
  fi
  case "${OMB_TEST_RC:-0}" in
    [0-9] | [0-9][0-9] | [0-9][0-9][0-9]) ;;
    *) _usage_error "OMB_TEST_RC must be an exit status" ; return 2 ;;
  esac
  case "$OMB_DRY_RUN" in
    0 | 1) ;;
    *) _usage_error "OMB_DRY_RUN must be 0 or 1, not '$OMB_DRY_RUN'" ; return 2 ;;
  esac
  case "$cmd" in
    sources) [ "${#rest[@]}" = 0 ] || { [ "${#rest[@]}" = 1 ] && [ "${rest[0]}" = --check ]; } ||
      { _usage_error "sources takes only --check" ; return 2; } ;;
    resume) [ "${#rest[@]}" -le 1 ] || { _usage_error "resume takes at most one token" ; return 2; } ;;
    shared)
      case "${rest[0]:-status}" in
        status | test) [ "${#rest[@]}" -le 1 ] || { _usage_error "shared ${rest[0]} takes no code" ; return 2; } ;;
        create | activate) [ "${#rest[@]}" -le 2 ] || { _usage_error "shared ${rest[0]} takes at most one code" ; return 2; } ;;
        *) _usage_error "shared takes status, create, activate or test" ; return 2 ;;
      esac
      ;;
    *) [ "${#rest[@]}" = 0 ] || { _usage_error "unexpected argument: ${rest[0]}" ; return 2; } ;;
  esac

  # A sane umask for everything this run creates, and for the installers it
  # launches: never group- or world-writable, whatever the caller inherited.
  umask 022
  ui_init
  # Help and version touch nothing: no probes, no state directory, no log.
  case "$cmd" in
    help) usage && return 0 ;;
    version) printf 'omarchy-bootstrap %s\n' "$OMB_VERSION" && return 0 ;;
  esac

  # Intent is decided from the command alone, before anything looks at where
  # the machine is: a read-only or planning command can never be routed into
  # an action by the machine's state (run and fetch_upstream enforce it).
  OMB_CMD=${cmd:-default}
  case "$cmd" in
    status | doctor | sources | logs) OMB_INTENT=read OMB_PERSIST=0 ;;
    shared)
      if [ "${rest[0]:-status}" = status ]; then OMB_INTENT=read OMB_PERSIST=0; else OMB_INTENT=act; fi
      ;;
    plan) OMB_INTENT=plan ;;
    *) OMB_INTENT=act ;;
  esac
  [ "$OMB_DRY_RUN" = 1 ] && OMB_PERSIST=0

  platform_init
  state_init || return 1
  # The frontend (docs/FRONTEND.md → When the frontend runs). No installer
  # flow is exposed through the protocol yet, so the only flow it can finish
  # is the foundation's own, over a fixture: the default run there, on a
  # terminal. Everything else — and every frontend failure — is the text
  # interface below. The frontend's session takes no lock of its own: each
  # core request takes the run lock itself.
  if [ -z "$cmd" ] && [ -n "${OMB_FIXTURE:-}" ] && [ -z "${OMB_NO_TUI:-}" ] &&
    [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then
    # shellcheck source=lib/records.sh
    . "$OMB_HOME/lib/records.sh" || _omb_unloaded records
    # shellcheck source=lib/core.sh
    . "$OMB_HOME/lib/core.sh" || _omb_unloaded core
    # shellcheck source=lib/frontend.sh
    . "$OMB_HOME/lib/frontend.sh" || _omb_unloaded frontend
    # The per-run scratch goes when the session ends; the text interface,
    # if the frontend falls back, sets its own exit handling below.
    trap omb_cleanup EXIT
    if [ "$OMB_DRY_RUN" = 1 ]; then fe_run dry-run "$FE_ALL_SCOPES"; else fe_run act "$FE_ALL_SCOPES"; fi
    case $? in
      0) return 0 ;;
      10) ;;
      *) return 1 ;;
    esac
  fi
  trap on_interrupt INT TERM
  trap 'ui_cursor_restore; omb_cleanup' EXIT
  # One recording run at a time; read-only runs and previews take no lock.
  if [ "$OMB_PERSIST" = 1 ]; then
    state_lock || return 1
  fi

  OMB_PHASE=$OMB_PLATFORM
  log_event start "omarchy-bootstrap $OMB_VERSION cmd=$OMB_CMD intent=$OMB_INTENT os=$OMB_OS uid=$OMB_UID dry_run=$OMB_DRY_RUN${OMB_FIXTURE:+ fixture=$(basename "$OMB_FIXTURE")}"

  case "$cmd" in
    sources) cmd_sources ${rest[@]+"${rest[@]}"} ; return ;;
    logs) cmd_logs ; return ;;
    doctor) cmd_doctor ; return ;;
    status) cmd_status ; return ;;
    shared) cmd_shared ${rest[@]+"${rest[@]}"} ; return ;;
  esac

  case "$OMB_PLATFORM" in
    macos)
      case "$cmd" in
        '' | install) mac_main install ;;
        plan) mac_main plan ;;
        resume) mac_resume ;;
        dev) mac_dev_note ;;
        *) _unknown "$cmd" ;;
      esac
      ;;
    linux)
      case "$cmd" in
        '') lx_main default ;;
        install) lx_main install ;;
        plan) lx_main plan ;;
        resume) lx_main resume ${rest[@]+"${rest[@]}"} ;;
        dev) dev_main ;;
        *) _unknown "$cmd" ;;
      esac
      ;;
    *)
      ui_header "unsupported system"
      ui_fail "This tool runs on macOS (Apple Silicon) and on Asahi Linux. Detected: ${OMB_OS:-unknown}."
      return 1
      ;;
  esac
}

_unknown() {
  ui_fail "Unknown command: $1"
  ui_note "Run omarchy-bootstrap --help for the list."
  return 2
}

cmd_logs() {
  ui_header "logs"
  ui_section "Location"
  ui_kv "State" "$(tildify "$OMB_STATE_DIR")"
  ui_kv "Logs" "$(tildify "$(log_dir)")"
  local latest
  latest=$(find "$(log_dir)" -name 'omarchy-bootstrap-*.log' 2>/dev/null | sort | tail -1)
  if [ -z "$latest" ]; then
    ui_note "No log yet."
    printf '\n'
    return 0
  fi
  ui_section "Recent" "$(basename "$latest")"
  tail -n 40 "$latest" | sed 's/^/   /'
  printf '\n'
}

main "$@"
