#!/bin/sh
# The fake handoff child of M14 gate 1 (data/children.omb → test.handoff): it
# owns the real terminal while it runs, reads a line from it, and writes WANT
# into EFFECT. Its behaviour comes from $OMB_FIXTURE/test-children/handoff
# (key=value). Ctrl-C makes it say so and exit, as its author intends.
effect=$1 want=$2
conf=${OMB_FIXTURE:-/nonexistent}/test-children/handoff
# get KEY — GOT: the value on KEY's last line of the fixture's file, read when
# asked (it may change while this child waits for its line), or empty; 1 when
# there is no file. The shell reads it itself, so a lookup starts no process,
# and its own variables leave the line typed at the terminal as it was.
get() {
  GOT=""
  [ -f "$conf" ] || return 1
  [ -r "$conf" ] || return 0
  while IFS= read -r __get_line || [ -n "$__get_line" ]; do
    case $__get_line in "$1"=*) GOT=${__get_line#"$1"=} ;; esac
  done <"$conf"
}

get fds
v=$GOT
[ -n "$v" ] && "$(dirname "$0")/probe-fds" >"$v"
get report
v=$GOT
if [ -n "$v" ] && [ -r /proc/self/status ]; then
  grep -E '^(SigBlk|SigIgn):' /proc/$$/status >"$v"
fi
trap 'echo "fake handoff child: interrupted"; exit 130' INT
echo "fake handoff child: type a line and press Enter"
IFS= read -r line || line=""
get keys_out
v=$GOT
[ -n "$v" ] && printf '%s' "$line" >"$v"
# Leave the terminal odd, as a careless program might: the frontend puts its
# saved settings back.
get leave_raw
[ "$GOT" = 1 ] && stty raw -echo
get effect
[ "$GOT" = none ] || printf '%s' "$want" >"$effect"
echo "fake handoff child: done"
exit 0
