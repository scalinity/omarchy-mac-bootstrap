#!/bin/sh
# The fake read child of M14 gate 1 (data/children.omb → test.read). Its
# behaviour comes from the fixture, $OMB_FIXTURE/test-children/read, lines of
# key=value; without it, one line of functional output and a little
# diagnostic noise. Never writes outside the paths the fixture names.
conf=${OMB_FIXTURE:-/nonexistent}/test-children/read
# get KEY — GOT: the value on KEY's last line of the fixture's file, read when
# asked (a test may rewrite or remove the file while this child runs), or
# empty; 1 when there is no file. The shell reads it itself, so a lookup
# starts no process: this child runs ten thousand times in one diagnostics test.
get() {
  GOT=""
  [ -f "$conf" ] || return 1
  [ -r "$conf" ] || return 0
  while IFS= read -r __get_line || [ -n "$__get_line" ]; do
    case $__get_line in "$1"=*) GOT=${__get_line#"$1"=} ;; esac
  done <"$conf"
}
# own PID — record a process this child started, with its start time, in the
# file the fixture names (pids=): a test signals only what it can name so.
own() {
  get pids && p=$GOT && [ -n "$p" ] || return 0
  printf '%s %s\n' "$1" "$(LC_ALL=C ps -p "$1" -o lstart= 2>/dev/null | awk '{$1 = $1; print}')" >>"$p"
}
if [ ! -f "$conf" ]; then
  echo "fake read child: a line of diagnostics" >&2
  echo "fixture read: ok"
  exit 0
fi

get fds
v=$GOT
[ -n "$v" ] && "$(dirname "$0")/probe-fds" >"$v"
get grandchild
v=$GOT
[ -n "$v" ] && {
  get grandchild_fds
  f=$GOT
  sh -c 'if [ -n "$1" ]; then "$2/probe-fds" >"$1"; fi; exec sleep "$0"' "$v" "$f" "$(dirname "$0")" &
  own $!
}
get stderr_text
v=$GOT
[ -n "$v" ] && printf '%s\n' "$v" >&2
# BSD head refuses -c 0: nothing to write is written as nothing.
get stderr_bytes
v=$GOT
[ -n "$v" ] && [ "$v" != 0 ] && head -c "$v" /dev/zero >&2
get stderr_bytes
b=$GOT
get stderr_text
[ -z "$b" ] && [ -z "$GOT" ] && echo "fake read child: a line of diagnostics" >&2
get stdout_bytes
v=$GOT
[ -n "$v" ] && head -c "$v" /dev/zero
get sleep
v=$GOT
[ -n "$v" ] && sleep "$v"
echo "fixture read: ok"
get exit
v=$GOT
[ -n "$v" ] && exit "$v"
exit 0
